* {
  box-sizing: border-box;
}

:root {
  --bg: #0a0a0f;
  --panel: rgba(20, 20, 28, 0.9);
  --panel-strong: #14141c;
  --border: rgba(255, 255, 255, 0.12);
  --text: #f8f3ef;
  --muted: #c7bfb8;
  --gold: #d9b57e;
  --accent: #7d8dff;
  --shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background:
    linear-gradient(rgba(10, 10, 15, 0.7), rgba(10, 10, 15, 0.8)),
    radial-gradient(circle at top, rgba(125, 141, 255, 0.22), transparent 40%),
    #0a0a0f;
  color: var(--text);
}

img {
  max-width: 100%;
  display: block;
}

.page-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 24px 24px 80px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0 28px;
  border-bottom: 1px solid var(--border);
}

.brand {
  font-family: 'Cormorant Garamond', serif;
  letter-spacing: 0.16em;
  font-size: 1.7rem;
  font-weight: 700;
}

nav {
  display: flex;
  gap: 20px;
}

nav a {
  color: var(--muted);
  text-decoration: none;
  font-size: 0.9rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hero {
  display: grid;
  grid-template-columns: 1.4fr 0.8fr;
  gap: 32px;
  padding: 64px 0 32px;
  align-items: center;
}

.eyebrow {
  color: var(--gold);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-size: 0.72rem;
  margin: 0 0 16px;
}

h1, h2, h3 {
  margin: 0;
  font-family: 'Cormorant Garamond', serif;
  font-weight: 600;
  line-height: 0.95;
}

h1 {
  font-size: clamp(3.2rem, 7vw, 6rem);
  letter-spacing: -0.04em;
  margin-bottom: 18px;
}

h2 {
  font-size: clamp(2.3rem, 5vw, 3.7rem);
  margin-bottom: 18px;
}

.lede {
  color: var(--muted);
  font-size: 1.06rem;
  line-height: 1.75;
  max-width: 620px;
}

.cta-group {
  display: flex;
  gap: 16px;
  margin-top: 28px;
}

.button {
  text-decoration: none;
  padding: 14px 22px;
  border-radius: 999px;
  font-size: 0.9rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border: 1px solid var(--border);
  transition: 0.2s ease;
}

.button.primary {
  background: linear-gradient(135deg, var(--gold), #f0c78c);
  color: #111;
  border-color: transparent;
}

.button.secondary {
  color: var(--text);
  background: rgba(255, 255, 255, 0.02);
}

.hero-card {
  background: linear-gradient(180deg, rgba(19, 21, 28, 0.9), rgba(9, 10, 15, 0.95));
  border: 1px solid var(--border);
  border-radius: 28px;
  min-height: 480px;
  padding: 28px;
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
}

.hero-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent 30%),
    radial-gradient(circle at 50% 30%, rgba(125, 141, 255, 0.35), transparent 35%);
}

.card-tag,
.poster-grid {
  position: relative;
  z-index: 1;
}

.card-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border);
  color: var(--gold);
  border-radius: 999px;
  padding: 8px 14px;
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.poster-grid {
  display: grid;
  gap: 18px;
  position: absolute;
  bottom: 26px;
  left: 28px;
  right: 28px;
  font-size: 0.82rem;
  color: var(--muted);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.panel {
  border: 1px solid var(--border);
  background: rgba(17, 17, 24, 0.8);
  border-radius: 24px;
  padding: 28px;
  margin-top: 28px;
}

.panel.accent {
  background: linear-gradient(180deg, rgba(18, 22, 36, 0.85), rgba(15, 13, 26, 0.8));
}

.section-heading {
  margin-bottom: 22px;
}

.story-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
  color: var(--muted);
  line-height: 1.75;
  font-size: 1.02rem;
}

.beat-grid,
.crew-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.beat-card,
.crew-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 22px 20px;
}

.beat-card span,
.role {
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.72rem;
}

.beat-card p,
.crew-card h3 {
  margin-top: 18px;
  line-height: 1.6;
}

.crew-card h3 {
  font-size: clamp(1.5rem, 3vw, 2.1rem);
}

.timeline-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 16px;
}

.timeline-list li {
  padding: 18px 20px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border);
  border-radius: 14px;
  color: var(--muted);
  line-height: 1.6;
}

@media (max-width: 780px) {
  .topbar,
  .hero,
  .story-grid,
  .beat-grid,
  .crew-grid {
    grid-template-columns: 1fr;
  }

  .topbar {
    display: grid;
    gap: 16px;
  }

  nav {
    flex-wrap: wrap;
  }

  .hero {
    padding-top: 32px;
  }

  .page-shell {
    padding-inline: 16px;
  }
}
